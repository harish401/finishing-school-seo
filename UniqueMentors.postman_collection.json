{
  "info": {
    "_postman_id": "c1f77d34-d021-4f10-91a9-b68e7b165b48",
    "name": "Unique Mentors Backend APIs",
    "description": "Postman Collection covering all active backend API endpoints for the Unique Mentors finishing school platform. Set the `base_url` variable to your active deployment URL (defaults to localhost:3000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Newsletter",
      "item": [
        {
          "name": "Subscribe to Newsletter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"subscribe@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/newsletter",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "newsletter"
              ]
            },
            "description": "Register email address to the Unique Mentors finishing school newsletter."
          },
          "response": []
        }
      ]
    },
    {
