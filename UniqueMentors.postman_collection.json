    },
    {
      "name": "Payments & Orders",
      "item": [
        {
          "name": "Create Razorpay Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 4999,\n  \"courseId\": \"65c2b3f1a0123456789abcde\",\n  \"studentId\": \"65c2b3e4a0123456789abcde\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/payments/create-order",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "payments",
                "create-order"
              ]
            },
            "description": "Initialize a transaction. Expects PAYMENT_ENABLED=true environment configuration to interface with Razorpay APIs and construct order receipts."
          },
          "response": []
        },
        {
          "name": "Razorpay Webhook Simulation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Razorpay-Signature",
                "value": "mock_signature_for_testing",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity\": \"event\",\n  \"account_id\": \"acc_BF4N2WDr241234\",\n  \"event\": \"payment.captured\",\n  \"contains\": [\n    \"payment\"\n  ],\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_DESLsHp141234\",\n        \"entity\": \"payment\",\n        \"amount\": 499900,\n        \"currency\": \"INR\",\n        \"status\": \"captured\",\n        \"order_id\": \"order_DESLsHp141234\",\n        \"invoice_id\": null,\n        \"international\": false,\n        \"method\": \"card\",\n        \"amount_refunded\": 0,\n        \"refund_status\": null,\n        \"captured\": true,\n        \"description\": \"Communication Mastery Course payment\",\n        \"card_id\": \"card_FE512asfd12\",\n        \"bank\": null,\n        \"wallet\": null,\n        \"vpa\": null,\n        \"email\": \"rajiv.sen@example.com\",\n        \"contact\": \"+919812345678\",\n        \"notes\": {\n          \"courseId\": \"65c2b3f1a0123456789abcde\",\n          \"studentId\": \"65c2b3e4a0123456789abcde\"\n        },\n        \"fee\": 9998,\n        \"tax\": 1800,\n        \"error_code\": null,\n        \"error_description\": null,\n        \"created_at\": 1779813534\n      }\n    }\n  },\n  \"created_at\": 1779813534\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/payments/webhook",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "payments",
                "webhook"
              ]
            },
            "description": "Simulate a captured payment confirmation webhook event originating from Razorpay nodes to verify inventory/enrollment status fulfillment updates."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
}
